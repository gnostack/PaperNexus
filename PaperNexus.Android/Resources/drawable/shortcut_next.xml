<?xml version="1.0" encoding="utf-8"?>
<!-- The "Next Wallpaper" entry's icon: the Current tab's Next glyph, dark on the launcher icon's
     green. An adaptive icon, so the launcher gives it the same shape as its other entries; a
     shortcut icon cannot be tinted, so the colors are in the drawing. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/icon_background" />
  <foreground android:drawable="@drawable/shortcut_next_glyph" />
</adaptive-icon>
