<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon. As an adaptive icon it fills the launcher's tile shape; a plain bitmap icon
     is drawn small inside a white circle. The launcher masks the outer sixth of each side of the
     foreground, so the logo is inset by that much and shows whole. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/icon_background" />
  <foreground>
    <inset android:drawable="@drawable/logo" android:inset="16.7%" />
  </foreground>
</adaptive-icon>
