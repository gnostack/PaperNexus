<!-- The line that confirms a tap on every phone tab (the shared StatusLine): white while working,
     green when it worked, red when it failed (the desktop status bar's colors). -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="TextBlock.status">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.status.success">
        <Setter Property="Foreground" Value="#4ADE80"/>
    </Style>
    <Style Selector="TextBlock.status.error">
        <Setter Property="Foreground" Value="#F87171"/>
    </Style>
</Styles>
