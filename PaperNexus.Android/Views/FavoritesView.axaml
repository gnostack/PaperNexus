<!-- The Favorites tab (issue #203, step 4): only the favorites, in the order they were hearted,
     with the Gallery's card. Its two buttons sit on the picture's bottom-left corner as on the
     desktop's Favorites card: set as current, and remove from favorites. Like the desktop's
     Favorites card it shows no banned tint. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PaperNexus.ViewModels"
             xmlns:views="using:PaperNexus.Views"
             x:Class="PaperNexus.Views.FavoritesView"
             x:DataType="vm:FavoritesViewModel">

    <UserControl.Styles>
        <StyleInclude Source="/Views/PictureListStyles.axaml"/>
        <StyleInclude Source="/Views/StatusLineStyles.axaml"/>
    </UserControl.Styles>

    <Panel>
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Cards"
                          ItemsSource="{Binding Items}"
                          ContainerPrepared="OnContainerPrepared"
                          ContainerClearing="OnContainerClearing">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GalleryItem">
                        <Border Classes="card">
                            <StackPanel>
                                <views:PictureFrame>
                                    <Grid>
                                        <!-- Placeholder while the thumbnail loads, or when the file is gone -->
                                        <Border Background="#2A2A2A"
                                                IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}">
                                            <PathIcon Data="M21 19V5C21 3.9 20.1 3 19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19ZM8.5 13.5L11 16.51L14.5 12L19 18H5L8.5 13.5Z"
                                                      Width="40" Height="40" Opacity="0.2"/>
                                        </Border>
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>

                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="8"
                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                            <Button Classes="onPicture"
                                                    Command="{Binding SetAsCurrentCommand}"
                                                    IsEnabled="{Binding CanSetAsCurrent}"
                                                    ToolTip.Tip="Set as current wallpaper">
                                                <PathIcon Data="M8 5V19L19 12Z"/>
                                            </Button>
                                            <Button Classes="onPicture"
                                                    Command="{Binding ToggleFavoriteCommand}"
                                                    IsEnabled="{Binding CanAct}"
                                                    ToolTip.Tip="Remove from favorites">
                                                <PathIcon Data="M19 6.41L17.59 5L12 10.59L6.41 5L5 6.41L10.59 12L5 17.59L6.41 19L12 13.41L17.59 19L19 17.59L13.41 12Z"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </views:PictureFrame>
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="16"
                                           Margin="12,8,12,10"
                                           TextWrapping="Wrap" MaxLines="2"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Text="{Binding EmptyText}"
                   FontSize="16" Opacity="0.7"
                   TextWrapping="Wrap" TextAlignment="Center"
                   Margin="32"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding IsEmpty}"/>

        <!-- The confirmation line, over the bottom of the list, above the tabs -->
        <Border Background="#1E1E1E" Padding="16,12"
                VerticalAlignment="Bottom"
                IsVisible="{Binding Status.IsShown}">
            <TextBlock Classes="status"
                       Classes.success="{Binding Status.IsSuccess}"
                       Classes.error="{Binding Status.IsError}"
                       Text="{Binding Status.Message}"/>
        </Border>
    </Panel>
</UserControl>
