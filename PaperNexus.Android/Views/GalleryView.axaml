<!-- The Gallery tab (issue #203, step 4): every downloaded picture, newest first, one card per
     row filling the width with its title beneath. The buttons sit on the picture's bottom
     corners as on the desktop's card: set as current and the heart on the left, ban and delete
     on the right. A banned picture is tinted red. Only the cards near the screen are built, and
     each card's thumbnail is loaded when it is built and released when it is cleared. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PaperNexus.ViewModels"
             xmlns:views="using:PaperNexus.Views"
             x:Class="PaperNexus.Views.GalleryView"
             x:DataType="vm:GalleryViewModel">

    <UserControl.Styles>
        <StyleInclude Source="/Views/PictureListStyles.axaml"/>
    </UserControl.Styles>

    <Panel>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Cards"
                          ItemsSource="{Binding Items}"
                          ContainerPrepared="OnContainerPrepared"
                          ContainerClearing="OnContainerClearing">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GalleryItem">
                        <Border Classes="card">
                            <StackPanel>
                                <views:PictureFrame>
                                    <Grid>
                                        <!-- Placeholder while the thumbnail loads -->
                                        <Border Background="#2A2A2A"
                                                IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}">
                                            <PathIcon Data="M21 19V5C21 3.9 20.1 3 19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19ZM8.5 13.5L11 16.51L14.5 12L19 18H5L8.5 13.5Z"
                                                      Width="40" Height="40" Opacity="0.2"/>
                                        </Border>
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                        <!-- The desktop's banned tint -->
                                        <Border Background="#AA660000" IsVisible="{Binding IsBanned}"/>

                                        <!-- Set as current and the heart -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="8"
                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                            <Button Classes="onPicture"
                                                    Command="{Binding SetAsCurrentCommand}"
                                                    IsEnabled="{Binding CanSetAsCurrent}"
                                                    ToolTip.Tip="Set as current wallpaper">
                                                <PathIcon Data="M8 5V19L19 12Z"/>
                                            </Button>
                                            <Button Classes="onPicture"
                                                    Command="{Binding ToggleFavoriteCommand}"
                                                    IsEnabled="{Binding CanAct}"
                                                    ToolTip.Tip="{Binding FavoriteToolTip}">
                                                <Panel>
                                                    <!-- Material Design icon "favorite_border" (Google, Apache License 2.0) -->
                                                    <PathIcon Data="M16.5 3c-1.74 0-3.41.81-4.5 2.09C10.91 3.81 9.24 3 7.5 3 4.42 3 2 5.42 2 8.5c0 3.78 3.4 6.86 8.55 11.54L12 21.35l1.45-1.32C18.6 15.36 22 12.28 22 8.5 22 5.42 19.58 3 16.5 3zm-4.4 15.55l-.1.1-.1-.1C7.14 14.24 4 11.39 4 8.5 4 6.5 5.5 5 7.5 5c1.54 0 3.04.99 3.57 2.36h1.87C13.46 5.99 14.96 5 16.5 5c2 0 3.5 1.5 3.5 3.5 0 2.89-3.14 5.74-7.9 10.05z"
                                                              IsVisible="{Binding !IsFavorite}"/>
                                                    <!-- The desktop's favorite heart, filled in the favorite color -->
                                                    <PathIcon Data="M12 21.35L10.55 20.03C5.4 15.36 2 12.28 2 8.5C2 5.42 4.42 3 7.5 3C9.24 3 10.91 3.81 12 5.09C13.09 3.81 14.76 3 16.5 3C19.58 3 22 5.42 22 8.5C22 12.28 18.6 15.36 13.45 20.03L12 21.35Z"
                                                              Foreground="#E06C75"
                                                              IsVisible="{Binding IsFavorite}"/>
                                                </Panel>
                                            </Button>
                                        </StackPanel>

                                        <!-- Ban and delete -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="8"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                            <Button Classes="onPicture"
                                                    Command="{Binding ToggleBanCommand}"
                                                    IsEnabled="{Binding CanAct}"
                                                    ToolTip.Tip="Ban/unban from rotation">
                                                <PathIcon Classes="ban" Classes.active="{Binding IsBanned}"
                                                          Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8 0-1.85.63-3.55 1.69-4.9L16.9 18.31C15.55 19.37 13.85 20 12 20zm6.31-3.1L7.1 5.69C8.45 4.63 10.15 4 12 4c4.42 0 8 3.58 8 8 0 1.85-.63 3.55-1.69 4.9z"/>
                                            </Button>
                                            <Button Classes="onPicture"
                                                    Command="{Binding DeleteCommand}"
                                                    IsEnabled="{Binding CanAct}"
                                                    ToolTip.Tip="Delete from disk">
                                                <PathIcon Data="M9 3H15L16 4H20V6H4V4H8L9 3ZM5 7H19L18.1 20.1C18 21.2 17.1 22 16 22H8C6.9 22 6 21.2 5.9 20.1L5 7Z"
                                                          Foreground="#E06C75"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </views:PictureFrame>
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="16"
                                           Margin="12,8,12,10"
                                           TextWrapping="Wrap" MaxLines="2"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Text="{Binding EmptyText}"
                   FontSize="16" Opacity="0.7"
                   TextWrapping="Wrap" TextAlignment="Center"
                   Margin="32"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding IsEmpty}"/>

        <!-- The confirmation line, over the bottom of the list, above the tabs -->
        <Border Background="#1E1E1E" Padding="16,12"
                VerticalAlignment="Bottom"
                IsVisible="{Binding HasStatus}">
            <TextBlock Classes="status"
                       Classes.success="{Binding IsStatusSuccess}"
                       Classes.error="{Binding IsStatusError}"
                       Text="{Binding StatusMessage}"/>
        </Border>
    </Panel>
</UserControl>
