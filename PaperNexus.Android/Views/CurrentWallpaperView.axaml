<!-- The Current tab (issue #203, steps 3 and 4): the current wallpaper full width, its title
     beneath it, and the heart, Next, Random and delete buttons. While there is no picture, a
     placeholder in the picture's place says why: downloading, or the download failed with a Try
     again button. A short line under the buttons confirms a heart or a delete; a red line says
     when the wallpaper cannot be changed. Delete asks first, in a box over the page. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PaperNexus.ViewModels"
             xmlns:views="using:PaperNexus.Views"
             x:Class="PaperNexus.Views.CurrentWallpaperView"
             x:DataType="vm:CurrentWallpaperViewModel">

    <UserControl.Styles>
        <StyleInclude Source="/Views/PictureListStyles.axaml"/>
        <!-- The delete icon keeps its color when disabled, so the whole button dims instead,
             as the desktop dims a disabled button. -->
        <Style Selector="Button.delete:disabled">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
    </UserControl.Styles>

    <Panel>
    <ScrollViewer>
        <StackPanel>

            <!-- The picture, edge to edge. Its bitmap is decoded to the screen's width in
                 code-behind, so a 4K source is not held at full size. -->
            <Image x:Name="Picture"
                   Stretch="Uniform"
                   IsVisible="{Binding IsShowing}"/>

            <!-- In the picture's place while there is none. -->
            <Border Background="#1E1E1E"
                    MinHeight="240"
                    IsVisible="{Binding !IsShowing}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" Margin="24">
                    <TextBlock Text="{Binding PlaceholderText}"
                               FontSize="16" Opacity="0.7"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                    <Button Content="Try again"
                            Classes="accent"
                            HorizontalAlignment="Center"
                            Command="{Binding TryAgainCommand}"
                            IsVisible="{Binding IsDownloadFailed}"
                            ToolTip.Tip="Download wallpapers again"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Title}"
                       FontSize="18" FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="16,12,16,0"
                       IsVisible="{Binding IsShowing}"/>

            <!-- The actions on the current wallpaper. Next and Random dim while either works. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="16,16,16,0">
                <Button Command="{Binding ToggleFavoriteCommand}"
                        IsEnabled="{Binding CanFavorite}"
                        ToolTip.Tip="{Binding FavoriteToolTip}"
                        MinWidth="48" MinHeight="48">
                    <Panel>
                        <!-- Material Design icon "favorite_border" (Google, Apache License 2.0) -->
                        <PathIcon Data="M16.5 3c-1.74 0-3.41.81-4.5 2.09C10.91 3.81 9.24 3 7.5 3 4.42 3 2 5.42 2 8.5c0 3.78 3.4 6.86 8.55 11.54L12 21.35l1.45-1.32C18.6 15.36 22 12.28 22 8.5 22 5.42 19.58 3 16.5 3zm-4.4 15.55l-.1.1-.1-.1C7.14 14.24 4 11.39 4 8.5 4 6.5 5.5 5 7.5 5c1.54 0 3.04.99 3.57 2.36h1.87C13.46 5.99 14.96 5 16.5 5c2 0 3.5 1.5 3.5 3.5 0 2.89-3.14 5.74-7.9 10.05z"
                                  Width="24" Height="24"
                                  IsVisible="{Binding !IsFavorite}"/>
                        <!-- The desktop's favorite heart, filled in the favorite color. -->
                        <PathIcon Data="M12 21.35L10.55 20.03C5.4 15.36 2 12.28 2 8.5C2 5.42 4.42 3 7.5 3C9.24 3 10.91 3.81 12 5.09C13.09 3.81 14.76 3 16.5 3C19.58 3 22 5.42 22 8.5C22 12.28 18.6 15.36 13.45 20.03L12 21.35Z"
                                  Width="24" Height="24"
                                  Foreground="#E06C75"
                                  IsVisible="{Binding IsFavorite}"/>
                    </Panel>
                </Button>
                <Button Command="{Binding NextCommand}"
                        IsEnabled="{Binding CanSwitch}"
                        ToolTip.Tip="Change to the next wallpaper"
                        MinHeight="48" Padding="16,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="M6 18L14.5 12L6 6V18ZM16 6V18H18V6H16Z" Width="18" Height="18"/>
                        <TextBlock Text="Next" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding RandomCommand}"
                        IsEnabled="{Binding CanSwitch}"
                        ToolTip.Tip="Change to a random wallpaper"
                        MinHeight="48" Padding="16,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="M1 7H10V17H14V22H1Z M11 1H23V16H11Z M2.5,11A1.5,1.5,0,1,1,5.5,11A1.5,1.5,0,1,1,2.5,11Z M5.5,14A1.5,1.5,0,1,1,8.5,14A1.5,1.5,0,1,1,5.5,14Z M8.5,19A1.5,1.5,0,1,1,11.5,19A1.5,1.5,0,1,1,8.5,19Z M13,4.5A1.5,1.5,0,1,1,16,4.5A1.5,1.5,0,1,1,13,4.5Z M18,4.5A1.5,1.5,0,1,1,21,4.5A1.5,1.5,0,1,1,18,4.5Z M13,12.5A1.5,1.5,0,1,1,16,12.5A1.5,1.5,0,1,1,13,12.5Z M18,12.5A1.5,1.5,0,1,1,21,12.5A1.5,1.5,0,1,1,18,12.5Z"
                                  Width="18" Height="18"/>
                        <TextBlock Text="Random" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- The desktop's delete-current-wallpaper button -->
                <Button Classes="delete"
                        Click="OnDeleteClicked"
                        IsEnabled="{Binding CanDelete}"
                        ToolTip.Tip="Delete current wallpaper"
                        MinWidth="48" MinHeight="48">
                    <PathIcon Data="M9 3H15L16 4H20V6H4V4H8L9 3ZM5 7H19L18.1 20.1C18 21.2 17.1 22 16 22H8C6.9 22 6 21.2 5.9 20.1L5 7ZM10 10V19H12V10H10ZM14 10V19H16V10H14Z"
                              Width="24" Height="24"
                              Foreground="#E06C75"/>
                </Button>
            </StackPanel>

            <!-- Confirms a heart or a delete for three seconds: green when it worked, red when not -->
            <TextBlock Text="{Binding StatusMessage}"
                       Classes="status"
                       Classes.success="{Binding IsStatusSuccess}"
                       Classes.error="{Binding IsStatusError}"
                       TextAlignment="Center"
                       Margin="16,12,16,0"
                       IsVisible="{Binding HasStatus}"/>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#F87171"
                       FontSize="14"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Margin="16,12,16,16"
                       IsVisible="{Binding HasError}"/>
        </StackPanel>
    </ScrollViewer>

    <views:ConfirmationDialog x:Name="Confirmation"/>
    </Panel>
</UserControl>
