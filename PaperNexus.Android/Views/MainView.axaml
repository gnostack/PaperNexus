<!-- The phone's main screen: five tabs along the bottom (issue #203, decision 9). TabbedPage places
     its tabs at the bottom on Android and draws each page's Icon above its Header. Current shows the
     current wallpaper (step 3), Gallery and Favorites the pictures and Sources the wallpaper
     sources (step 4); Settings shows only its own name until its content arrives. -->
<TabbedPage xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:views="using:PaperNexus.Views"
            x:Class="PaperNexus.Views.MainView"
            SelectionChanged="OnSelectionChanged"
            Background="#2B2B2B">

    <!-- Fluent's defaults color the selected tab with the plain accent, which is darker on this
         background than the grey of the unselected tabs. The selected tab uses the lighter accent
         shade and the others a dimmer grey, so the selected one is the bright one. -->
    <TabbedPage.Resources>
        <SolidColorBrush x:Key="TabbedPageTabItemHeaderForegroundSelected" Color="{DynamicResource SystemAccentColorLight1}"/>
        <SolidColorBrush x:Key="TabbedPageTabItemHeaderForegroundUnselected" Color="{DynamicResource SystemBaseMediumLowColor}"/>
    </TabbedPage.Resources>

    <!-- The desktop window background, instead of the theme's black page background. -->
    <TabbedPage.Styles>
        <Style Selector="ContentPage">
            <Setter Property="Background" Value="#2B2B2B"/>
        </Style>
    </TabbedPage.Styles>

    <ContentPage Header="Current">
        <ContentPage.Icon>
            <!-- Material Design icon "wallpaper" (Google, Apache License 2.0), https://github.com/google/material-design-icons -->
            <PathIcon Data="M4 4h7V2H4c-1.1 0-2 .9-2 2v7h2V4zm6 9l-4 5h12l-3-4-2.03 2.71L10 13zm7-4.5c0-.83-.67-1.5-1.5-1.5S14 7.67 14 8.5s.67 1.5 1.5 1.5S17 9.33 17 8.5zM20 2h-7v2h7v7h2V4c0-1.1-.9-2-2-2zm0 18h-7v2h7c1.1 0 2-.9 2-2v-7h-2v7zM4 13H2v7c0 1.1.9 2 2 2h7v-2H4v-7z"/>
        </ContentPage.Icon>
        <views:CurrentWallpaperView x:Name="CurrentWallpaper"/>
    </ContentPage>

    <ContentPage x:Name="GalleryPage" Header="Gallery">
        <ContentPage.Icon>
            <!-- The desktop's Gallery tab icon (MainWindow.axaml). -->
            <PathIcon Data="M22 16V4C22 2.9 21.1 2 20 2H8C6.9 2 6 2.9 6 4V16C6 17.1 6.9 18 8 18H20C21.1 18 22 17.1 22 16ZM11 12L13.03 14.71L16 11L20 16H8L11 12ZM2 6V20C2 21.1 2.9 22 4 22H18V20H4V6H2Z"/>
        </ContentPage.Icon>
        <views:GalleryView x:Name="Gallery"/>
    </ContentPage>

    <ContentPage x:Name="FavoritesPage" Header="Favorites">
        <ContentPage.Icon>
            <!-- The desktop's Favorites tab icon (MainWindow.axaml). -->
            <PathIcon Data="M12 21.35L10.55 20.03C5.4 15.36 2 12.27 2 8.5C2 5.41 4.42 3 7.5 3C9.24 3 10.91 3.81 12 5.08C13.09 3.81 14.76 3 16.5 3C19.58 3 22 5.41 22 8.5C22 12.27 18.6 15.36 13.45 20.03L12 21.35Z"/>
        </ContentPage.Icon>
        <views:FavoritesView x:Name="Favorites"/>
    </ContentPage>

    <ContentPage x:Name="SourcesPage" Header="Sources">
        <ContentPage.Icon>
            <!-- The desktop's Wallpaper Sources tab icon (MainWindow.axaml). -->
            <PathIcon Data="M21 3H3C2 3 1 4 1 5V19C1 21 2 21 3 21H21C22 21 23 21 23 19V5C23 4 22 3 21 3ZM21 19H3V5H21V19ZM13 10H17V12H13V10ZM13 14H17V16H13V14ZM7 10H11V16H7V10Z"/>
        </ContentPage.Icon>
        <views:SourcesView x:Name="Sources"/>
    </ContentPage>

    <ContentPage Header="Settings">
        <ContentPage.Icon>
            <!-- Material Design icon "settings" (Google, Apache License 2.0), https://github.com/google/material-design-icons -->
            <PathIcon Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
        </ContentPage.Icon>
        <TextBlock Text="Settings" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </ContentPage>
</TabbedPage>
