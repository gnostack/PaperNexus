<!-- The Secrets list (issue #203, step 4): the desktop's Secrets window as a full-screen page over
     the tabs, with its layout and text - the title, the line under it, how many are found with
     the bar, one row per egg the phone has (a filled box when found, the egg's name and its
     hint), and Close at the bottom. Android's back closes it too. Sizes are the phone's. -->
<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PaperNexus.ViewModels"
             x:Class="PaperNexus.Views.SecretsPage"
             x:DataType="vm:SettingsViewModel"
             Background="#2B2B2B">

    <ContentPage.Styles>
        <!-- The desktop's colours: found boxes yellow and names white, the rest grey -->
        <Style Selector="TextBlock.mark">
            <Setter Property="Foreground" Value="#6A6A6E"/>
        </Style>
        <Style Selector="TextBlock.mark.found">
            <Setter Property="Foreground" Value="#FFD93D"/>
        </Style>
        <Style Selector="TextBlock.name">
            <Setter Property="Foreground" Value="#6A6A6E"/>
        </Style>
        <Style Selector="TextBlock.name.found">
            <Setter Property="Foreground" Value="#F5F5F5"/>
        </Style>
    </ContentPage.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="SECRETS" FontSize="20" FontWeight="Bold" LetterSpacing="3"
                       Foreground="#FFD93D"/>
            <TextBlock Text="Hidden things scattered through the app. Find them all."
                       FontSize="14" Opacity="0.6" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- The count and a chunky pixel-style bar, as on the desktop -->
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,20,0,16">
            <TextBlock Text="{Binding Secrets.ProgressText}"
                       FontSize="14" FontWeight="Bold" Foreground="#8BE9FD" LetterSpacing="1"
                       TextWrapping="Wrap"/>
            <Border x:Name="ProgressTrack" Background="#1E1E1E" BorderBrush="#3A3A3E" BorderThickness="2" Height="16">
                <Rectangle x:Name="ProgressBar" Fill="#FFD93D" HorizontalAlignment="Left" Width="0"/>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Secrets.Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SecretRow">
                        <Border Background="#1E1E1E" CornerRadius="4" Padding="16,12" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto,16,*">
                                <TextBlock Grid.Column="0"
                                           Classes="mark"
                                           Classes.found="{Binding IsFound}"
                                           Text="{Binding Mark}"
                                           FontSize="22"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Classes="name"
                                               Classes.found="{Binding IsFound}"
                                               Text="{Binding Name}"
                                               FontSize="16" FontWeight="Bold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Hint}"
                                               FontSize="13" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="3" Content="Close"
                Command="{Binding CloseSecretsCommand}"
                ToolTip.Tip="Close the secrets list"
                HorizontalAlignment="Right" Margin="0,12,0,0"
                MinHeight="48" MinWidth="88"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
    </Grid>
</ContentPage>
