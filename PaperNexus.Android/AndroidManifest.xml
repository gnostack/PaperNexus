<?xml version="1.0" encoding="utf-8"?>
<!-- The app's one activity is declared here by hand rather than generated from MainActivity's
     [Activity] attribute, because its configChanges must include assetsPaths, which the .NET
     Android manifest generator drops from the attribute (ConfigChanges.AssetsPaths). The build
     merges the rest of the manifest (application, permissions, providers) as before; for an
     activity declared here it generates nothing, so this entry carries everything the
     attribute used to: the launcher intent filter and exported.

     configChanges: rotation, window size and dark/light mode are handled by Avalonia inside the
     running activity, and so is assetsPaths. On Android 12 and later every new wallpaper makes
     the system rebuild its wallpaper-based color overlays, which is an asset paths change; an
     activity that does not take it is destroyed and recreated, which threw the person back to
     the Current tab after each wallpaper change (issue #203, step 4). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <activity android:name="com.gnostack.papernexus.MainActivity"
              android:exported="true"
              android:configChanges="orientation|screenSize|uiMode|assetsPaths">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <!-- The long-press menu's "Next Wallpaper" and "Random Wallpaper" (issue #203, step 6).
           Android reads an app's entries only from its launcher activity. -->
      <meta-data android:name="android.app.shortcuts"
                 android:resource="@xml/shortcuts" />
    </activity>
    <!-- What those entries start: an activity that shows nothing, changes the wallpaper and
         finishes (ShortcutActivity). Its own task (empty taskAffinity), so the app's screen is
         neither brought forward nor destroyed by the CLEAR_TASK flag an entry always carries;
         never in Recents and never kept in a back stack. Not exported: Android starts an
         entry's activity on the app's own behalf, and no other app may change the wallpaper
         through it. configChanges lists every change that would otherwise recreate it in the
         middle of its own change, assetsPaths above all: each new wallpaper is one. -->
    <activity android:name="com.gnostack.papernexus.ShortcutActivity"
              android:exported="false"
              android:theme="@style/PaperNexusShortcutTheme"
              android:taskAffinity=""
              android:excludeFromRecents="true"
              android:noHistory="true"
              android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection|keyboard|keyboardHidden|navigation|assetsPaths" />
  </application>
</manifest>
