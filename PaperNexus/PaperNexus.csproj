<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- WinExe suppresses the console window on Windows; on Linux it is treated as Exe. -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PaperNexus</AssemblyName>
    <Version>0.0.0</Version>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- AVLN3001: a window with no parameterless constructor is not reachable by Avalonia's
         runtime markup loader. MainWindow, SplashScreen and EasterEggListDialog deliberately
         have none, so no window can be built without the settings store; they are created
         from the service container, and the app never uses the runtime loader. The cost is
         that the IDE markup previewer cannot open these windows. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    <!-- Embed the URL of the repository this build came from as AssemblyMetadata("RepositoryUrl").
         The SDK's built-in source control support reads it from the checkout's git origin remote;
         see RequireRepositoryUrl below. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PaperNexus.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CronExpressionDescriptor" Version="2.51.0" />
    <PackageReference Include="Cronos" Version="0.13.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="3.119.2" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" Exclude="Assets\*.ttf;Assets\*-OFL.txt" />
    <EmbeddedResource Include="Assets\Cinzel.ttf" LogicalName="PaperNexus.Cinzel.ttf" />
  </ItemGroup>

  <!-- The auto-updater, the Report Bug link and the project link all address the GitHub repository
       named in the RepositoryUrl assembly metadata (read by GitHubRepository). It comes from git
       rather than a value written in the repo, so a transfer or rename of the repository is picked up
       by the next build instead of leaving a stale owner/name compiled into every installed client
       (issue #179: the transfer to the gnostack organization). A build with no origin remote has nothing to
       embed, so it stops here rather than shipping a binary that cannot find its own releases. -->
  <Target Name="RequireRepositoryUrl"
          AfterTargets="InitializeSourceControlInformation"
          BeforeTargets="GetAssemblyAttributes">
    <Error Condition="'$(RepositoryUrl)' == '' and '$(PrivateRepositoryUrl)' == ''"
           Text="PaperNexus embeds its GitHub repository URL from the git 'origin' remote, and none was found. Build from a git clone whose 'origin' remote points at the GitHub repository (git remote add origin https://github.com/OWNER/PaperNexus)." />
  </Target>

</Project>
