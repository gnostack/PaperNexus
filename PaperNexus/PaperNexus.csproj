<Project Sdk="Microsoft.NET.Sdk">

  <!-- The desktop host for Windows and Linux: Program, the tray App, the windows and dialogs,
       install, auto-update, single instance, startup registration and the platform layer.
       Everything the phone also needs lives in PaperNexus.Shared. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- WinExe suppresses the console window on Windows; on Linux it is treated as Exe. -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PaperNexus</AssemblyName>
    <Version>0.0.0</Version>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- AVLN3001: a window with no parameterless constructor is not reachable by Avalonia's
         runtime markup loader. MainWindow, SplashScreen and EasterEggListDialog deliberately
         have none, so no window can be built without the settings store; they are created
         from the service container, and the app never uses the runtime loader. The cost is
         that the IDE markup previewer cannot open these windows. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PaperNexus.Tests" />
  </ItemGroup>

  <!-- Only the desktop platform package; every other package arrives through PaperNexus.Shared. -->
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PaperNexus.Shared\PaperNexus.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
